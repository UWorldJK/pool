{
  "name": "pool",
  "description": "Pool web application and server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-test-module-mocks --test scripts/*.test.mjs",
    "test:auth": "node scripts/auth-browser.mjs",
    "test:db": "node scripts/auth-browser.mjs --database-only",
    "db:types": "node scripts/auth-browser.mjs --write-types",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "supabase:start": "supabase start --network-id pool-local",
    "supabase:stop": "supabase stop --network-id pool-local",
    "supabase:status": "supabase status --network-id pool-local",
    "supabase:reset": "supabase db reset --local --network-id pool-local",
    "supabase:check": "node --env-file-if-exists=.env.local scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pg": "8.16.3",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}

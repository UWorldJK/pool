{
  "name": "pool",
  "description": "Pool shared web and iOS application",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "expo start --web --port 3000",
    "build": "expo export --platform web",
    "start": "node scripts/serve.mjs",
    "lint": "eslint src scripts tests --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:components",
    "test:auth": "node scripts/auth-browser.mjs",
    "test:db": "node scripts/auth-browser.mjs --database-only",
    "db:types": "node scripts/auth-browser.mjs --write-types",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:ios",
    "supabase:start": "supabase start --network-id pool-local",
    "supabase:stop": "supabase stop --network-id pool-local",
    "supabase:status": "supabase status --network-id pool-local",
    "supabase:reset": "supabase db reset --local --network-id pool-local",
    "supabase:check": "node --env-file-if-exists=.env.local scripts/check-supabase.mjs",
    "ios": "expo run:ios",
    "build:ios": "expo export --platform ios --output-dir dist-ios",
    "test:unit": "node --experimental-test-module-mocks --test scripts/*.test.mjs",
    "test:components": "jest --runInBand",
    "test:ios": "node scripts/ios-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "expo": "58.0.21",
    "expo-router": "~58.0.28",
    "@tanstack/react-query": "^5.90.21",
    "react-native-url-polyfill": "^2.0.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-constants": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "expo-dev-client": "~58.0.17",
    "expo-crypto": "~58.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "pg": "8.16.3",
    "supabase": "2.122.0",
    "typescript": "5.9.3",
    "eslint-config-expo": "~58.0.0",
    "jest-expo": "~58.0.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0"
  },
  "main": "expo-router/entry"
}

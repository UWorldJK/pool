{
  "expo": {
    "name": "Pool",
    "slug": "pool",
    "scheme": "pool",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.pool.prototype",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Pool"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "webOrigin": "http://localhost:3000"
    }
  }
}

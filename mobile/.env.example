# Copy to .env.local. Values are bundled into the app, so only use public keys.
# Simulator can reach local Supabase at localhost. A physical iPhone or
# TestFlight build needs a hosted Supabase project URL instead.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Native invitation links use the matching web origin; Simulator default is local web.
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3000

# Copy to .env.local. Get the local publishable key with npm run supabase:status.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
# Use a publishable key (sb_publishable_...) or a legacy anon key, never an admin key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Native invitation links use the matching web origin; Simulator default is local web.
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3000

PORT=3000

# Copy to .env.local. Get the local publishable key with npm run supabase:status.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by Next.js server code in Docker. Leave unset when running npm run
# dev on the host or when deploying against hosted Supabase.
SUPABASE_INTERNAL_URL=http://api.supabase.internal:8000

PORT=3000
